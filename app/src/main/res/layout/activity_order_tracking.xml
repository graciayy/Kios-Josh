<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <!-- Mock Map View Area -->
    <RelativeLayout
        android:id="@+id/rl_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ll_driver_info_panel"
        android:background="#D1E8E2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ Interactive Delivery Route Map ]\nDriver: Josh Peterson (En Route)"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_centerInParent="true" />

    </RelativeLayout>

    <!-- Bottom Driver Status Panel -->
    <LinearLayout
        android:id="@+id/ll_driver_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tv_tracking_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated Delivery: 15-20 mins"
            android:textColor="@color/primary_orange"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preparing your Bubur Manado with special ingredients..."
            android:textColor="@color/medium_gray"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/sym_def_app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Josh Peterson"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yamaha NMAX • DB 4920 AM"
                    android:textColor="@color/medium_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_call_driver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Driver"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_orange" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
