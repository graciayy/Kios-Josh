<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded Product Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="#FFEBEBEB">

                <ImageView
                    android:id="@+id/iv_admin_product_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_report_image" />
            </androidx.cardview.widget.CardView>

            <!-- Product Information Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_admin_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tinutuan (Bubur Manado)"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <!-- Price and Stock Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_admin_product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 10,000"
                        android:textColor="@color/primary_orange"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_admin_product_stock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="stok: 50"
                        android:textColor="@color/primary_orange"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:background="#158B261D" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_admin_product_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Makanan"
                    android:textColor="@color/medium_gray"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Availability Status Badge -->
            <TextView
                android:id="@+id/tv_admin_product_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sedia"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@color/accent_green" />
        </LinearLayout>

        <!-- Dynamic Description -->
        <TextView
            android:id="@+id/tv_admin_product_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bubur Manado otentik dimasak dengan labu, ubi manis..."
            android:textColor="@color/medium_gray"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp" />

        <!-- Row Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFEBEBEB"
            android:layout_marginBottom="10dp" />

        <!-- Right Side: Mini Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Toggle Availability Button -->
            <Button
                android:id="@+id/btn_toggle_availability"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Ubah"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="@color/black"
                android:backgroundTint="#FFF9F4E8"
                android:layout_marginEnd="5dp" />

            <!-- Edit Product Button -->
            <Button
                android:id="@+id/btn_product_edit"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Edit"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_light"
                android:layout_marginEnd="5dp" />

            <!-- Delete Product Button -->
            <Button
                android:id="@+id/btn_product_delete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Hapus"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/error_red" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
